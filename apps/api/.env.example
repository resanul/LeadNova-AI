PROJECT_NAME="GlobalLead AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL for prod, SQLite async for local dev)
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/globallead_db"
DATABASE_URL="sqlite+aiosqlite:///./globallead.db"

# JWT Security
SECRET_KEY="production-grade-random-secret-key-change-in-production-leadnova-ai"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Super Admin Seed
FIRST_SUPERUSER_EMAIL="admin@globallead.ai"
FIRST_SUPERUSER_PASSWORD="AdminPassword123!"

# Telephony Sandbox
TWILIO_ACCOUNT_SID="AC_mock_twilio_account_sid"
TWILIO_AUTH_TOKEN="mock_twilio_auth_token"
DEFAULT_CALL_TIMEOUT_SECONDS=60

# AI Provider Gateway
AI_PROVIDER="mock_gateway" # "gemini", "openai", "mock_gateway"
GEMINI_API_KEY=""
